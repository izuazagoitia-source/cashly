{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/estado_situacion_financiera.pdf",
      "dest": "/public/estado_situacion_financiera.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
